---
componentName:  orkalinux
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 960px,660px
windowPlacement: center

strings:
    productName:         "@ORKA_NAME@"
    shortProductName:    "@ORKA_NAME@"
    version:             "@ORKA_VERSION@ (@ORKA_CODENAME@)"
    shortVersion:        "@ORKA_VERSION@"
    versionedName:       "@ORKA_NAME@ @ORKA_VERSION@"
    shortVersionedName:  "@ORKA_NAME@ @ORKA_VERSION@"
    bootloaderEntryName: "@ORKA_NAME@"
    productUrl:          "@ORKA_URL@"
    supportUrl:          "@ORKA_DISCORD@"
    knownIssuesUrl:      "@ORKA_URL@"
    releaseNotesUrl:     "https://github.com/cyz-yt/OrkaLinux/releases"

sidebar: qml,top
navigation: qml,bottom

images:
    productLogo:         "orkalinux-logo-white.png"
    productIcon:         "orka-install.png"
    productWelcome:      "orkalinux-logo-white.png"

slideshow:               "show.qml"

style:
   SidebarBackground:    "#13152a"
   SidebarText:          "#eceefa"
   SidebarTextCurrent:   "#ffffff"
   SidebarBackgroundCurrent: "#4f58f0"

slideshowAPI: 2
