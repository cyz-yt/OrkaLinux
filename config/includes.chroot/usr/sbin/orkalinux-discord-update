#!/bin/sh
set -eu

URL="https://discord.com/api/download?platform=linux&format=deb"

installed="$(dpkg-query -W -f='${Version}' discord 2>/dev/null || true)"
if [ -z "$installed" ]; then
	echo "Discord nie jest zainstalowany – nic do zrobienia"
	exit 0
fi

location="$(curl -fsSI --retry 3 "$URL" | tr -d '\r' | awk 'tolower($1) == "location:" { print $2 }' | tail -n 1)"
latest="$(printf '%s\n' "$location" | sed -n 's|.*/discord-\([0-9][0-9.]*\)\.deb$|\1|p')"
if [ -z "$latest" ]; then
	echo "Nie udało się sprawdzić najnowszej wersji Discorda (przekierowanie: ${location:-brak})" >&2
	exit 1
fi

if dpkg --compare-versions "$latest" le "$installed"; then
	echo "Discord $installed jest aktualny"
	exit 0
fi

echo "Aktualizuję Discorda: $installed -> $latest"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
chmod 755 "$tmp"
curl -fL --retry 3 -o "$tmp/discord.deb" "$location"
chmod 644 "$tmp/discord.deb"
DEBIAN_FRONTEND=noninteractive apt-get install -y "$tmp/discord.deb"
echo "Gotowe: Discord $latest (nowa wersja działa po ponownym uruchomieniu Discorda)"
