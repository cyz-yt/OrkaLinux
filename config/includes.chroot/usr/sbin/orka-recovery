wt() {
	whiptail --backtitle "$T_back" --ok-button "$T_ok" --cancel-button "$T_cancel" \
		--yes-button "$T_yes" --no-button "$T_no" "$@" 3>&1 1>&2 2>&3
}

msg() { wt --title "OrkaLinux Recovery" --msgbox "$1" 12 70; }

ask() { wt --title "OrkaLinux Recovery" --defaultno --yesno "$1" 14 74; }

console_begin() {
	clear
	printf '\033[1;44;97m %-78s\033[0m\n\n' "$T_back"
	printf '%s\n\n' "$1"
	echo "=== $(date '+%F %T') $1" >> "$LOG"
}

console_end() {
	echo
	if [ "$1" -eq 0 ]; then
		printf '\033[1;32m%s\033[0m\n' "$T_done"
	else
		printf '\033[1;31m%s\033[0m\n' "$T_failed"
	fi
	printf '%s' "$T_enter"
	read -r _
}

run() {
	echo "\$ $*" | tee -a "$LOG"
	"$@" 2>&1 | tee -a "$LOG"
	return "${PIPESTATUS[0]}"
}

network() {
	echo "$T_net"
	systemctl start NetworkManager >/dev/null 2>&1
	if ! nm-online -q -t 30; then
		echo "$T_no_net"
		return 1
	fi
	return 0
}

pick_user() {
	local items=()
	while IFS=: read -r name _ uid _ _ home _; do
		[ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home" ] && items+=("$name" "$home")
	done < /etc/passwd
	if [ ${#items[@]} -eq 0 ]; then
		msg "$T_no_users"
		return 1
	fi
	wt --title "OrkaLinux Recovery" --menu "$T_pick_user" 16 70 6 "${items[@]}"
}

do_restore() {
	local list items=() name date pick
	list="$("$HELPER" list 2>/dev/null | python3 -c '
import json, sys, time
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
for s in sorted(data.get("snapshots", []), key=lambda s: s["name"], reverse=True):
    d = time.strftime("%d.%m.%Y %H:%M", time.strptime(s["name"], "%Y-%m-%d_%H-%M-%S"))
    print(s["name"] + "\t" + (d + "   " + s["comment"]).strip())
')"
	if [ -z "$list" ]; then
		msg "$T_no_points"
		return
	fi
	while IFS=$'\t' read -r name date; do
		items+=("$name" "$date")
	done <<< "$list"
	pick="$(wt --title "OrkaLinux Recovery" --notags --menu "$T_pick_point" 18 76 8 "${items[@]}")" || return
	date="$(printf '%s\n' "$list" | awk -F'\t' -v n="$pick" '$1 == n { print $2 }')"
	ask "$(printf "$T_restore_q" "${date%%   *}")" || return
	run_restore "$pick"
}

RLOG=/run/orka-recovery-restore.log
DONE_RE='Restore completed|completed successfully|Rebooting|sent [0-9,.]+ bytes'
run_restore() {
	local pick="$1" start=$SECONDS rc pct last el out prompt
	echo "=== $(date '+%F %T') restore $pick" > "$RLOG"
	"$HELPER" restore "$pick" >> "$RLOG" 2>&1 &
	local pid=$!
	prompt="$(printf '%s\n\n%s 0:00\n-' "$T_restoring" "$T_elapsed")"
	while kill -0 "$pid" 2>/dev/null; do
		out="$(tail -c 8192 "$RLOG" | tr '\r' '\n')"
		el=$((SECONDS - start))
		if printf '%s\n' "$out" | grep -Eq "$DONE_RE"; then
			pct=100
			last="$T_restored"
		else
			pct="$(printf '%s\n' "$out" | grep -o '[0-9]\{1,3\}\(\.[0-9]*\)\? *%' | tail -n 1 | sed 's/[.% ].*//')"
			[ "$pct" = 0 ] && pct=""
			last="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | grep -v '^\*\**$' | tail -n 1 | cut -c 1-60)"
			[ -n "$pct" ] || pct=$(awk -v t="$el" 'BEGIN { printf "%d", 95 * (1 - exp(-t * 0.693 / 120)) }')
		fi
		printf 'XXX\n%s\n%s\n\n%s %d:%02d\n%s\nXXX\n' "$pct" "$T_restoring" "$T_elapsed" $((el / 60)) $((el % 60)) "${last:--}"
		sleep 1
	done | whiptail --backtitle "$T_back" --title "OrkaLinux Recovery" --gauge "$prompt" 13 72 0
	wait "$pid"
	rc=$?
	cat "$RLOG" >> "$LOG" 2>/dev/null
	if [ "$rc" -eq 0 ]; then
		msg "$T_restored"
		systemctl reboot
		sleep 30
	else
		msg "$T_failed"
	fi
}

do_packages() {
	console_begin "$T_packages"
	network
	local rc=0
	run dpkg --configure -a || rc=1
	run apt-get -f install -y || rc=1
	run apt-get update || rc=1
	run apt-get -f install -y || rc=1
	console_end $rc
}

do_boot() {
	console_begin "$T_boot"
	local rc=0
	mount -a 2>/dev/null
	run update-initramfs -u -k all || rc=1
	if [ -d /boot/efi/loader ] && command -v bootctl >/dev/null; then
		run bootctl update --graceful || rc=1
		for k in /boot/vmlinuz-*; do
			[ -e "$k" ] || continue
			v="${k#/boot/vmlinuz-}"
			run kernel-install add "$v" "$k" "/boot/initrd.img-$v" || rc=1
		done
	elif [ -d /sys/firmware/efi ]; then
		run grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=debian \
			--force-extra-removable --recheck || rc=1
		run update-grub || rc=1
	else
		disk="$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null | head -n 1)"
		if [ -n "$disk" ]; then
			run grub-install "/dev/$disk" || rc=1
		fi
		run update-grub || rc=1
	fi
	console_end $rc
}

do_space() {
	console_begin "$T_space"
	echo "$T_space_before $(df -h --output=avail / | tail -n 1 | tr -d ' ')"
	echo
	run apt-get clean
	run journalctl --vacuum-size=100M
	command -v flatpak >/dev/null && run flatpak uninstall --unused -y --noninteractive
	rm -rf /var/tmp/* 2>/dev/null
	echo
	echo "$T_space_after $(df -h --output=avail / | tail -n 1 | tr -d ' ')"
	console_end 0
}

do_desktop() {
	local user home backup f
	user="$(pick_user)" || return
	home="$(getent passwd "$user" | cut -d: -f6)"
	ask "$(printf "$T_desktop_q" "$user")" || return
	backup="$home/.config/orka-recovery-backup/$(date +%Y-%m-%d_%H-%M)"
	mkdir -p "$backup"
	for f in plasma-org.kde.plasma.desktop-appletsrc plasmashellrc plasmarc kwinrc kwinrulesrc \
		kdeglobals kglobalshortcutsrc khotkeysrc kscreenlockerrc ksplashrc kcminputrc \
		plasma-localerc powermanagementprofilesrc; do
		[ -e "$home/.config/$f" ] && mv "$home/.config/$f" "$backup/"
	done
	rm -rf "$home"/.cache/plasma* "$home"/.cache/ksycoca6* "$home"/.cache/kwin 2>/dev/null
	chown -R "$user:" "$home/.config/orka-recovery-backup"
	echo "=== $(date '+%F %T') desktop reset $user -> $backup" >> "$LOG"
	msg "$(printf "$T_desktop_done" "$backup")"
}

nvidia_installed() {
	dpkg-query -W -f '${Package} ${Status}\n' 'nvidia-*' 'libnvidia-*' 2>/dev/null | grep -q ' installed$'
}

do_nvidia() {
	ask "$T_nvidia_q" || return
	console_begin "$T_nvidia"
	local pkgs rc=0
	pkgs="$(dpkg-query -W -f '${Package} ${Status}\n' 'nvidia-*' 'libnvidia-*' 'firmware-nvidia-*' 2>/dev/null \
		| awk '$NF == "installed" { print $1 }')"
	[ -n "$pkgs" ] && { run apt-get purge -y $pkgs || rc=1; }
	run apt-get autoremove -y || rc=1
	run update-initramfs -u -k all || rc=1
	console_end $rc
}

do_password() {
	local user
	user="$(pick_user)" || return
	clear
	printf '\033[1;44;97m %-78s\033[0m\n\n' "$T_back"
	passwd "$user"
	printf '\n%s' "$T_enter"
	read -r _
}

do_shell() {
	clear
	printf '\033[1;44;97m %-78s\033[0m\n\n%s\n\n' "$T_back" "$T_shell_hint"
	bash -l
}

clear

PENDING=/var/lib/orkalinux/restore-pending
if [ -s "$PENDING" ]; then
	pending="$(head -n 1 "$PENDING")"
	rm -f "$PENDING"
	case "$pending" in
		[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9]-[0-9][0-9]-[0-9][0-9]) run_restore "$pending" ;;
	esac
fi

while true; do
	items=(
		restore "$T_restore"
		packages "$T_packages"
		boot "$T_boot"
		space "$T_space"
		desktop "$T_desktop"
	)
	nvidia_installed && items+=(nvidia "$T_nvidia")
	admin_allowed && items+=(
		password "$T_password"
		shell "$T_shell"
	)
	items+=(
		continue "$T_continue"
		reboot "$T_reboot"
		poweroff "$T_poweroff"
	)
	choice="$(wt --title "OrkaLinux Recovery" --notags --nocancel --menu "$T_menu" 22 78 12 "${items[@]}")" || continue
	case "$choice" in
		restore) do_restore ;;
		packages) do_packages ;;
		boot) do_boot ;;
		space) do_space ;;
		desktop) do_desktop ;;
		nvidia) do_nvidia ;;
		password) admin_allowed && do_password ;;
		shell) admin_allowed && do_shell ;;
		continue) clear; systemctl --no-block isolate graphical.target; exit 0 ;;
		reboot) clear; systemctl reboot; sleep 30 ;;
		poweroff) clear; systemctl poweroff; sleep 30 ;;
	esac
done
