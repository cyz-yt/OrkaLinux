#!/bin/bash
export TERM=linux
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOG=/var/log/orka-recovery.log
HELPER=/usr/sbin/orka-kopia-helper
CONF=/etc/orkalinux/recovery.conf
admin_allowed() { ! grep -qx 'ALLOW_ADMIN=no' "$CONF" 2>/dev/null; }

dmesg -n 1 2>/dev/null

export NEWT_COLORS='
root=white,blue
roottext=white,blue
window=white,black
border=brightblue,black
shadow=black,black
title=brightcyan,black
textbox=white,black
button=white,blue
actbutton=blue,white
compactbutton=white,black
listbox=white,black
actlistbox=white,blue
actsellistbox=white,blue
sellistbox=white,black
entry=white,blue
disentry=gray,black
emptyscale=,black
fullscale=,brightblue
'

[ -f /boot/grub/grubenv ] && grub-editenv /boot/grub/grubenv unset next_entry 2>/dev/null

L=en
if [ -r /etc/default/locale ]; then
	lang="$(sed -n 's/^LANG=//p' /etc/default/locale | tr -d '"')"
	case "$lang" in pl*) L=pl ;; de*) L=de ;; fr*) L=fr ;; es*) L=es ;; it*) L=it ;; pt*) L=pt ;; uk*) L=uk ;; esac
fi
export LANG="${lang:-C.UTF-8}"

if [ "$L" = uk ] && command -v setfont >/dev/null; then
	for f in CyrSlav-Terminus32x16 CyrSlav-Terminus28x14 CyrSlav-Terminus16 Uni2-Terminus16; do
		setfont "$f" 2>/dev/null && break
	done
fi

