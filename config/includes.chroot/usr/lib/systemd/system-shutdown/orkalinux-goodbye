#!/bin/sh
if grep -qw splash /proc/cmdline && ! grep -q plymouth.enable=0 /proc/cmdline; then
	exit 0
fi

{
	echo
	case "$1" in
		reboot|kexec)
			cat <<'ART'
   _____                                __
  / ___/___  ___     __  ______  __  __/ /
  \__ \/ _ \/ _ \   / / / / __ \/ / / / /
 ___/ /  __/  __/  / /_/ / /_/ / /_/ /_/
/____/\___/\___/   \__, /\____/\__,_(_)
                  /____/
ART
			;;
		*)
			cat <<'ART'
   ______                ____               __
  / ____/___  ____  ____/ / /_  __  _____  / /
 / / __/ __ \/ __ \/ __  / __ \/ / / / _ \/ /
/ /_/ / /_/ / /_/ / /_/ / /_/ / /_/ /  __/_/
\____/\____/\____/\__,_/_.___/\__, /\___(_)
                             /____/
ART
			;;
	esac
	. /etc/os-release 2>/dev/null
	echo "   ${PRETTY_NAME:-OrkaLinux}  -  by _inc0gnit0"
	echo
} > /dev/console 2>/dev/null
sleep 2
exit 0
