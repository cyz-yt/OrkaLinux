
Window.SetBackgroundTopColor(0.06, 0.07, 0.13);
Window.SetBackgroundBottomColor(0.06, 0.07, 0.13);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

scale = screen_h / 1080;
if (scale > 1) scale = 1;
if (scale < 0.6) scale = 0.6;

logo_image = Image("logo.png");
logo_image = logo_image.Scale(logo_image.GetWidth() * scale, logo_image.GetHeight() * scale);
logo = Sprite(logo_image);
logo.SetX(screen_w / 2 - logo_image.GetWidth() / 2);
logo.SetY(screen_h * 0.42 - logo_image.GetHeight() / 2);

dot_size = 8;
dot_image = Image("dot.png");
dot_image = dot_image.Scale(dot_size * scale, dot_size * scale);
count = 5;
radius = dot_size * 2.25 * scale;
center_x = screen_w / 2;
center_y = screen_h * 0.78;
for (i = 0; i < count; i++)
{
	dots[i] = Sprite(dot_image);
	dots[i].SetZ(2);
}

frame = 0;
cycle = 110;
lag = 7;

fun refresh_callback()
{
	global.frame++;
	for (i = 0; i < count; i++)
	{
		f = (global.frame + cycle * 10 - i * lag) % cycle;
		p = f / cycle;
		a = 2 * Math.Pi * (p - 0.16 * Math.Sin(2 * Math.Pi * p));
		x = center_x + radius * Math.Sin(a);
		y = center_y - radius * Math.Cos(a);
		dots[i].SetX(x - dot_image.GetWidth() / 2);
		dots[i].SetY(y - dot_image.GetHeight() / 2);
		dots[i].SetOpacity(1 - i * 0.12);
	}
}

Plymouth.SetRefreshFunction(refresh_callback);

fun display_password_callback(prompt, bullets)
{
	text = "";
	for (i = 0; i < bullets; i++)
		text = text + "•";
	global.prompt_sprite = Sprite(Image.Text(prompt, 1, 1, 1));
	global.prompt_sprite.SetPosition(screen_w / 2 - global.prompt_sprite.GetImage().GetWidth() / 2, screen_h * 0.6, 10);
	global.bullets_sprite = Sprite(Image.Text(text, 1, 1, 1));
	global.bullets_sprite.SetPosition(screen_w / 2 - global.bullets_sprite.GetImage().GetWidth() / 2, screen_h * 0.6 + 30 * scale, 10);
}

fun display_normal_callback()
{
	global.prompt_sprite = NULL;
	global.bullets_sprite = NULL;
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
